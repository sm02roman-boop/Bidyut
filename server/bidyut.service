[Unit]
Description=Bidyut NESCO meter poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bidyut
WorkingDirectory=/opt/bidyut/server
ExecStart=/usr/bin/node /opt/bidyut/server/index.js
Environment=BIDYUT_CONFIG=/opt/bidyut/server/config.json

Restart=always
RestartSec=20

# The process reads one public portal and writes its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bidyut/server/data

[Install]
WantedBy=multi-user.target
